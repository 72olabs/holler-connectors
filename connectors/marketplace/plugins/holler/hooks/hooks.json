{
  "description": "Register and hydrate Holler on every Codex session lifecycle boundary.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/scripts/holler\" hook --harness codex",
            "statusMessage": "Connecting to Holler",
            "additionalContextLimit": 1000,
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "other",
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/scripts/holler\" session-end --harness codex",
            "statusMessage": "Disconnecting from Holler",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/scripts/holler\" codex-attention --event PostToolUse",
            "statusMessage": "Checking Holler attention",
            "additionalContextLimit": 1000,
            "timeout": 5
          }
        ],
        "matcher": ".*"
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/scripts/holler\" codex-attention --event Stop",
            "statusMessage": "Checking Holler attention",
            "additionalContextLimit": 1000,
            "timeout": 5
          }
        ]
      }
    ]
  }
}
